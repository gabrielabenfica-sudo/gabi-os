# ─── Banco de dados (obrigatório) ────────────────────────────────
DATABASE_URL="postgresql://gabi:gabi@localhost:5432/gabi"

# ─── Segurança (obrigatório em produção) ─────────────────────────
# Chave de 32 bytes em base64 para criptografar tokens de integrações.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# URL pública do app (usada em links e callbacks OAuth)
APP_URL="http://localhost:3000"

# Permitir novos cadastros depois que a primeira usuária existir? (padrão: false)
ALLOW_REGISTRATION="false"

# ─── Agendador (opcional) ────────────────────────────────────────
# CRON_SECRET=""

# ─── Google Calendar (opcional) ──────────────────────────────────
# Google Cloud → APIs: ative a Google Calendar API; Credenciais: ID do cliente OAuth
# (aplicativo da Web) com redirecionamento APP_URL/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Instagram via Meta (opcional) ───────────────────────────────
# developers.facebook.com → app com Login do Facebook para Empresas; permissões
# instagram_basic, instagram_manage_insights, pages_show_list, pages_read_engagement,
# business_management; redirecionamento APP_URL/api/integrations/meta/callback
META_APP_ID=""
META_APP_SECRET=""
